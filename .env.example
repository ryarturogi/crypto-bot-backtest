# ---- Exchange ----
# Any exchange id ccxt can fetch public OHLCV from.
# `npx tsx src/cli.ts doctor` lists what works from your network.
EXCHANGE_ID=kucoin

# ---- Market ----
SYMBOL=BTC/USDT
TIMEFRAME=1h

# ---- Strategy ----
# Moving-average windows for the sma-crossover strategy.
SMA_FAST=20
SMA_SLOW=50

# ---- Risk ----
# Position size = equity × RISK_PER_TRADE ÷ STOP_LOSS_PCT, capped by MAX_POSITION_USD.
# The loader refuses a combination whose stop-out loss would exceed 50% of equity.
RISK_PER_TRADE=0.01
MAX_POSITION_USD=500
MAX_DRAWDOWN=0.20
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_OPEN_TRADES=3

# ---- Backtest ----
BACKTEST_DAYS=365
INITIAL_CAPITAL=10000

# Taker fee per side, as a fraction. 0.001 = 0.1%.
FEE_RATE=0.001

# ---- Logging ----
# debug | info | warn | error
LOG_LEVEL=info

# This repository is a backtester. It places no orders and reads no API keys.
# Live and paper trading live in the separate crypto-bot-kit product.